{
  "//": "Template only. Copy values into User Secrets or environment variables; never commit real secrets.",
  "ConnectionStrings": {
    "CentralAuth": "Server=.\\SQLEXPRESS;Database=CentralAuth;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "Issuer": "https://localhost:7090",
    "Audience": "https://localhost:7090"
  },
  "Secrets": {
    "//": "Signing private keys as PEM text, keyed by SigningKey.PrivateKeyReference. Put real values in User Secrets or env (Secrets__<name>)."
  },
  "SecretFiles": {
    "//": "Alternative: a path to a PEM file per PrivateKeyReference, e.g. \"signing-key-1\": \"C:/keys/signing-key-1.pem\"."
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Errors": {
    "//": "Only honored in the Development environment; responses never carry exception details anywhere else.",
    "IncludeExceptionDetails": false
  },
  "RateLimiting": {
    "//": "Defaults shown for Login; also Refresh, Register, ForgotPassword, ResetPassword. Paths maps request paths to these kinds.",
    "Policies": {
      "Login": {
        "PerIp": { "PermitLimit": 20, "Window": "00:01:00" },
        "PerAccount": { "PermitLimit": 10, "Window": "00:15:00" }
      }
    },
    "MaxAccountBodyBytes": 16384
  },
  "ForwardedHeaders": {
    "//": "Only list the reverse proxies in front of the API. Empty (default) means X-Forwarded-For is ignored.",
    "KnownProxies": []
  },
  "PasswordHashing": {
    "MaxConcurrentOperations": 4,
    "QueueTimeout": "00:00:05"
  },
  "Lockout": {
    "FailuresBeforeLockout": 5,
    "BaseLockout": "00:01:00",
    "MaxLockout": "01:00:00",
    "FailureWindow": "01:00:00",
    "LevelDecayAfter": "1.00:00:00"
  },
  "RefreshTokens": {
    "MaxSessionsPerUser": 20
  },
  "Retention": {
    "Enabled": true,
    "Interval": "01:00:00",
    "BatchSize": 1000,
    "RefreshTokenBatchSize": 500,
    "MaxBatchesPerRun": 50,
    "OneTimeTokens": "7.00:00:00",
    "RefreshFamilies": "30.00:00:00",
    "AuditLog": "365.00:00:00",
    "HighVolumeAuditLog": "90.00:00:00"
  },
  "AccountEmail": {
    "VerifyEmailUrl": "https://app.example.com/verify-email",
    "VerificationTokenLifetime": "1.00:00:00",
    "ResetPasswordUrl": "https://app.example.com/reset-password",
    "ResetTokenLifetime": "00:15:00"
  },
  "SessionLiveness": {
    "CacheDuration": "00:00:05"
  },
  "Authorization": {
    "SeedOnStartup": true,
    "BootstrapAdminEmail": null
  },
  "OAuth": {
    "LoginUrl": "https://login.example.com/signin"
  },
  "ClientApplications": {
    "Bootstrap": {
      "ClientId": "central-auth-spa",
      "Name": "Central auth SPA",
      "Audience": "api://central-auth-spa",
      "AllowedOrigins": [ "https://login.example.com" ],
      "RedirectUris": [],
      "PostLogoutRedirectUris": []
    }
  },
  "DevelopmentEmail": {
    "PickupDirectory": null
  },
  "AllowedHosts": "auth.example.com",
  "https_port": 443
}
