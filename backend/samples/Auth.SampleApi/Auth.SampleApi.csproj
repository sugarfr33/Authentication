<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- T22 sample resource server: accepts central-auth access tokens through Auth.Client (JWKS only, no secret, no database). -->
  <PropertyGroup>
    <StartupObject>Auth.SampleApi.SampleApiProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Auth.Client\Auth.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read from the content root when run; never copied into the output of projects that reference the sample (tests). -->
    <Content Update="appsettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
